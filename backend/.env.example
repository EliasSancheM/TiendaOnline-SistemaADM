PORT=5000
# OBLIGATORIO. Mínimo 32 caracteres — el servidor no arranca con un secret débil.
# Generar uno fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRET_FUERTE_ALEATORIO
SESSION_TIMEOUT=24h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000

# Orígenes autorizados del frontend. Admite VARIOS separados por coma: en Vercel
# conviene añadir tanto el dominio de producción como el de las previews.
#   CORS_ORIGIN=https://mi-panaderia.vercel.app,https://mi-panaderia-git-main-usuario.vercel.app
CORS_ORIGIN=http://localhost:3000

# URL pública del frontend. Se usa para redirigir al usuario tras pagar con Webpay.
FRONTEND_URL=http://localhost:3000

NODE_ENV=development

# Base de datos: sqlite (default) o postgresql
DB_TYPE=sqlite

# PostgreSQL (solo si DB_TYPE=postgresql)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=panaderia
# PG_USER=postgres
# PG_PASSWORD=tu_password

# Para despliegues en la nube (ej: Railway, Heroku) con PostgreSQL
# DATABASE_URL=postgresql://usuario:contraseña@host:puerto/database
# PG_SSL=true

# ─── Solo para despliegue en la nube ────────────────────────────────────
# URL pública del PROPIO backend. Webpay redirige aquí al confirmar el pago.
# Si no se define se deduce de la petición, lo que falla detrás de algunos proxies.
# BACKEND_URL=https://mi-backend.up.railway.app

# Directorio de las imágenes subidas. El disco del contenedor es EFÍMERO: sin
# esto, las fotos de productos se borran en cada redespliegue. Apuntar al punto
# de montaje de un volumen persistente.
# UPLOADS_DIR=/data/uploads

# Saltos de proxy inverso en los que confiar para obtener la IP real del cliente.
# Sin esto el rate limit trata a todos los visitantes como una sola IP.
# Por defecto: 1 en producción, desactivado en desarrollo. Nunca poner "true"
# (permitiría falsear la IP con la cabecera X-Forwarded-For).
# TRUST_PROXY=1

# SameSite de la cookie de sesión. Si el frontend y el backend están en dominios
# DISTINTOS (Vercel + Railway) debe ser "none" o el navegador no envía la cookie
# y nadie puede iniciar sesión. Por defecto ya es "none" en producción.
# Si algún día ambos comparten dominio, "lax" es más seguro.
# COOKIE_SAMESITE=none

# Configuración de Gmail (opcional - para correos de bienvenida y recuperación
# de contraseña). Sin esto, "olvidé mi contraseña" no envía nada.
# GMAIL_USER=tu_correo@gmail.com
# GMAIL_APP_PASSWORD=tu_app_password
# FROM_EMAIL=tu_correo@gmail.com

# Integración Webpay Plus (Opcional - por defecto usa Integración/Pruebas, que
# NO cobra dinero real. Para cobrar de verdad hacen falta las credenciales de
# comercio entregadas por Transbank.)
# WEBPAY_COMMERCE_CODE=tu_codigo_de_comercio_produccion
# WEBPAY_API_KEY=tu_api_key_produccion
# WEBPAY_ENVIRONMENT=production

# Tratamiento del IVA en las facturas.
# true (por defecto): los precios del catalogo son los que ve el cliente, con IVA
#   incluido, asi que el total del pedido es el importe final y el impuesto se
#   desglosa hacia atras (neto = total / 1.19).
# false: el catalogo esta en valores netos y el IVA se suma encima.
# Cambiar esto altera los importes de las facturas que se emitan a partir de ahora.
PRECIOS_IVA_INCLUIDO=true

# Alta de rescate del administrador.
# Si se define, al arrancar se crea el usuario 'administrador' con esta
# contrasena, o se le asigna si ya existe (y se reactiva con rol admin).
# Sirve para recuperar el acceso al panel cuando se pierde la contrasena
# aleatoria que se imprime una sola vez al crear la base de datos.
# BORRAR la variable despues de entrar: mientras exista, la contrasena queda
# visible para cualquiera con acceso al panel del proveedor.
# ADMIN_PASSWORD=
# ADMIN_USERNAME=administrador
