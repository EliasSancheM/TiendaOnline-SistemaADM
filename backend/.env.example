PORT=5000
# Generar un secret fuerte: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=CAMBIAR_POR_UN_SECRET_FUERTE_ALEATORIO
SESSION_TIMEOUT=24h
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1000
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# Base de datos: sqlite (default) o postgresql
DB_TYPE=sqlite

# PostgreSQL (solo si DB_TYPE=postgresql)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=panaderia
# PG_USER=postgres
# PG_PASSWORD=tu_password

# API Key de Google Generative AI
GEMINI_API_KEY=TU_API_KEY_AQUI

# Configuración de Gmail (opcional - para correos de bienvenida)
# GMAIL_USER=tu_correo@gmail.com
# GMAIL_APP_PASSWORD=tu_app_password
# FROM_EMAIL=tu_correo@gmail.com
